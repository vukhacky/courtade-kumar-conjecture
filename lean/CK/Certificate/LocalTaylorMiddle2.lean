theorem coefficients_eq : coefficients = Dense.variableScale ((487/500)^2)
    (Dense.localCoeffs 128 24 (589/800) (487/500) (3465735902799729/5000000000000000)) := by
  unfold coefficients Dense.variableScale Dense.localCoeffs Dense.baseCoeffs Dense.linearMul Dense.monomial Dense.scale Dense.add
  decide +kernel

theorem coefficients_checked : Dense.checkNonneg coefficients = true := by
  unfold Dense.checkNonneg coefficients
  decide +kernel

theorem polynomial_nonneg {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) ((487/500)^2)) :
    0 ≤ CK.localTaylorPolynomial 128 24 (589/800) (487/500) (3465735902799729/5000000000000000) x := by
  have hu : x / ((487/500 : ℝ)^2) ∈ Set.Icc (0 : ℝ) 1 := by
    constructor
    · exact div_nonneg hx.1 (by norm_num)
    · exact (div_le_one (by norm_num)).mpr hx.2
  have h := Dense.checkNonneg_sound coefficients_checked hu
  rw [coefficients_eq,Dense.eval_variableScale,Dense.eval_localCoeffs] at h
  norm_num at h ⊢
  convert h using 1 <;> congr 1 <;> ring

end
