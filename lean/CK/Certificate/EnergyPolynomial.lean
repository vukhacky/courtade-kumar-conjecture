theorem coefficients_eq : coefficients = Dense.variableScale (457/500)
    (Dense.energyCoeffs 24 (193027/250000) (693147181/1000000000) (1/1000000)) := by
  unfold coefficients Dense.variableScale Dense.energyCoeffs Dense.phiCoeffs Dense.squareVariable Dense.baseCoeffs Dense.quadraticMul Dense.scale Dense.add
  decide +kernel

theorem coefficients_checked : Dense.checkNonneg coefficients = true := by
  unfold Dense.checkNonneg coefficients
  decide +kernel

theorem log_two_le : Real.log 2 ≤ (693147181/1000000000:ℝ) := by
  linarith [P03.log_two_bounds.2]

theorem central_energy_polynomial_pos {rho : ℝ} (hrho : rho ∈ Set.Icc (0:ℝ) (457/500)) :
    0 < (1-rho)*(1+rho-(193027/250000:ℝ)*rho^2) -
      ((76-49*rho^2)/57)*((693147181/1000000000:ℝ)-CK.phiTaylor 24 rho) := by
  have hu : rho / (457/500:ℝ) ∈ Set.Icc (0:ℝ) 1 := by
    constructor
    · exact div_nonneg hrho.1 (by norm_num)
    · exact (div_le_one (by norm_num)).mpr hrho.2
  have h := Dense.checkNonneg_sound coefficients_checked hu
  rw [coefficients_eq,Dense.eval_variableScale,Dense.eval_energyCoeffs] at h
  norm_num at h
  have hid : (457/500:ℝ)*(rho/(457/500))=rho := by ring
  norm_num at hid
  rw [hid] at h
  linarith

end
