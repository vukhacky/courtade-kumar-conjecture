def slope (x : ℝ) : ℝ := Dense.eval slopeCoefficients x
def tail (x : ℝ) : ℝ := Dense.eval tailCoefficients x
def primitive (t : ℝ) : ℝ := Dense.eval primitiveCoefficients t
def entropyTail (x : ℝ) : ℝ := Dense.eval entropyTailCoefficients x
def slopeRemainder : List ℚ := Dense.add [1]
  (Dense.scale (-1) (Dense.linearMul 1 (-1) (Dense.mul slopeCoefficients slopeCoefficients)))

theorem primitive_derivative_coefficients :
    Dense.derivative primitiveCoefficients = Dense.squareVariable slopeCoefficients := by
  unfold primitiveCoefficients slopeCoefficients Dense.derivative Dense.squareVariable Dense.add
  decide +kernel

theorem hasDerivAt_primitive (t : ℝ) : HasDerivAt primitive (slope (t^2)) t := by
  have h := Dense.hasDerivAt_eval primitiveCoefficients t
  rw [primitive_derivative_coefficients,Dense.eval_squareVariable] at h
  exact h

theorem primitive_eq (t : ℝ) : primitive t = t+t^3*tail (t^2) := by
  norm_num [primitive,tail,primitiveCoefficients,tailCoefficients,Dense.eval]
  ring

theorem slope_nonneg {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) 1) : 0 ≤ slope x := by
  exact Dense.checkNonneg_sound (cs:=slopeCoefficients)
    (by unfold Dense.checkNonneg slopeCoefficients; decide +kernel) hx

theorem tail_nonneg {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) 1) : 0 ≤ tail x := by
  exact Dense.checkNonneg_sound (cs:=tailCoefficients)
    (by unfold Dense.checkNonneg tailCoefficients; decide +kernel) hx

theorem entropyTail_nonneg {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) 1) : 0 ≤ entropyTail x := by
  exact Dense.checkNonneg_sound (cs:=entropyTailCoefficients)
    (by unfold Dense.checkNonneg entropyTailCoefficients; decide +kernel) hx

theorem slopeRemainder_checked : Dense.checkNonneg slopeRemainder = true := by
  unfold Dense.checkNonneg slopeRemainder slopeCoefficients
  decide +kernel

theorem slope_squared_bound {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) 1) :
    (1-x)*(slope x)^2 ≤ 1 := by
  have h := Dense.checkNonneg_sound slopeRemainder_checked hx
  simp only [slopeRemainder,Dense.eval_add,Dense.eval_scale,Dense.eval_linearMul,Dense.eval_mul,Dense.eval] at h
  norm_num at h
  change (1-x)*(Dense.eval slopeCoefficients x)^2 ≤ 1
  nlinarith only [h]

theorem entropyTail_identity (t : ℝ) :
    CK.phiTaylor 32 t + (1/(1-(49/50:ℝ)^2))*CK.phiTaylorTerm 32 t =
      t^2/2+t^4*entropyTail (t^2) := by
  norm_num [CK.phiTaylor,CK.phiTaylorTerm,Finset.sum_range_succ,entropyTail,entropyTailCoefficients,Dense.eval]
  ring

theorem interior_coefficients_identity : interiorCoefficients =
    Dense.variableScale ((49/50:ℚ)^2)
      (Dense.add (Dense.scale (114/100) tailCoefficients)
        (Dense.add (0::Dense.scale (-1) (Dense.mul tailCoefficients tailCoefficients))
          (Dense.scale (-12/7) entropyTailCoefficients))) := by
  unfold interiorCoefficients Dense.variableScale Dense.add Dense.scale Dense.mul tailCoefficients entropyTailCoefficients
  decide +kernel

theorem interior_coefficients_checked : Dense.checkNonneg interiorCoefficients = true := by
  unfold Dense.checkNonneg interiorCoefficients
  decide +kernel

theorem interior_polynomial_nonneg {x : ℝ} (hx : x ∈ Set.Icc (0:ℝ) ((49/50:ℝ)^2)) :
    0 ≤ 2*(57/100:ℝ)*tail x-x*(tail x)^2-(12/7:ℝ)*entropyTail x := by
  have hu : x/((49/50:ℝ)^2) ∈ Set.Icc (0:ℝ) 1 := by
    constructor
    · exact div_nonneg hx.1 (by norm_num)
    · exact (div_le_one (by norm_num)).mpr hx.2
  have h := Dense.checkNonneg_sound interior_coefficients_checked hu
  rw [interior_coefficients_identity,Dense.eval_variableScale] at h
  norm_num only [Rat.cast_pow,Rat.cast_div,Rat.cast_ofNat] at h
  have hxid : (2401/2500:ℝ)*(x/(2401/2500))=x := by ring
  rw [hxid] at h
  simp only [Dense.eval_add,Dense.eval_scale,Dense.eval_mul,Dense.eval] at h
  norm_num at h
  dsimp [tail,entropyTail]
  nlinarith only [h]

end
