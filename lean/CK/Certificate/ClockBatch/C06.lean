def weights : Fin 3 → ℝ := ![(1 : ℝ), (2 : ℝ), (1 : ℝ)]
def parameters : Fin 3 → ℝ := ![v001, v003, v005]
def profile (e : ℝ) : ℝ := ∑ i : Fin 3, weights i*CK.Profile.profile e (parameters i)

theorem weights_nonneg : ∀ i, 0 ≤ weights i := by
  intro i
  fin_cases i <;> norm_num [weights]

theorem parameters_nonneg : ∀ i, 0 ≤ parameters i := by
  intro i
  fin_cases i
  · change 0 ≤ v001
    have h := v001_bound.1
    norm_num at h
    linarith
  · change 0 ≤ v003
    have h := v003_bound.1
    norm_num at h
    linarith
  · change 0 ≤ v005
    have h := v005_bound.1
    norm_num at h
    linarith

theorem profile_nonneg {e : ℝ} (he : 0 < e) : 0 ≤ profile e := by
  apply Finset.sum_nonneg
  intro i _
  exact mul_nonneg (weights_nonneg i) (CK.Profile.profile_nonneg he (parameters_nonneg i))

theorem profile_continuous : ContinuousOn profile (Set.Ioi (0 : ℝ)) :=
