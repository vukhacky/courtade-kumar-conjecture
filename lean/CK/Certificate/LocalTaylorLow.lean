module

public import CK.Certificate.DenseTaylor

/-! Exact full-interval Taylor polynomial certificate. Producer output is
checked as rational data, then interpreted by the proved Horner/Bernstein checker. -/

@[expose] public section
set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 5000000

namespace CK.Certificate.LocalTaylorLow
noncomputable section

